# Ensayo local. No es todavía la configuración pública.
ENVIRONMENT=development

# Usa valores aleatorios hexadecimales.
# No uses las contraseñas de desarrollo ni valores con @, % o $.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

SITE_ADDRESS=http://localhost
FRONTEND_URL=http://localhost:8080

WEB_BIND_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

YOLO_CONFIDENCE=0.50

# Completar en .env.deploy cuando corresponda probar el correo.
# No pegues credenciales reales en esta plantilla.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
    